{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/ReportThemeSchema/reportThemeSchema-2.126.json",
  "name": "VarejoMax Brasil",
  "dataColors": [
    "#1E3A5F",
    "#D95D39",
    "#2A9D8F",
    "#E9A825",
    "#5C6BC0",
    "#6D8B74",
    "#8D5B4C",
    "#3D5A80"
  ],
  "background": "#FAF7F2",
  "foreground": "#1F2933",
  "tableAccent": "#1E3A5F",
  "good": "#2E7D32",
  "neutral": "#E9A825",
  "bad": "#C0392B",
  "maximum": "#1E3A5F",
  "center": "#E9A825",
  "minimum": "#D95D39",
  "null": "#CBD5E1",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E3A5F"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2933"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#334155"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6DFD3" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2933" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12
          }
        ],
        "visualHeader": [
          {
            "background": { "solid": { "color": "#FFFFFF" } },
            "border": { "solid": { "color": "#E6DFD3" } },
            "foreground": { "solid": { "color": "#475569" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FAF7F2" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F0EAE0" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1E3A5F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "accentBar": [
          {
            "show": true,
            "color": { "solid": { "color": "#D95D39" } },
            "position": "Top",
            "width": 3
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "header": [
          {
            "fontColor": { "solid": { "color": "#1E3A5F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#334155" } },
            "background": { "solid": { "color": "#FAF7F2" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1E3A5F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1F2933" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1F2933" } },
            "backColorSecondary": { "solid": { "color": "#FAF7F2" } },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#1E3A5F" } },
            "backColor": { "solid": { "color": "#EFE8DC" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1E3A5F" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1F2933" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1F2933" } },
            "backColorSecondary": { "solid": { "color": "#FAF7F2" } },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#1E3A5F" } },
            "backColor": { "solid": { "color": "#EFE8DC" } },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}
